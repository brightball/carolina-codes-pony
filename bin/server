#!/usr/bin/env bash
# Build if needed, then run the Stallion listener.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$ROOT/build/carolina-codes-pony/pony"
export PATH="${HOME}/.local/share/ponyup/bin:${PATH}"
if [[ ! -x "$BIN" ]]; then
  mkdir -p "$ROOT/build/carolina-codes-pony"
  (cd "$ROOT" && corral fetch && corral run -- ponyc --path=. -Dopenssl_3.0.x -o "$ROOT/build/carolina-codes-pony" .)
fi
exec "$BIN"
